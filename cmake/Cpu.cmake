include_guard(GLOBAL)
option(STRINGKERNEL_ENABLE_SIMD "Build safely dispatched CPU vector backends" ON)

function(stringkernel_cpu_sources target)
  target_sources(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src/cpu_kernels.cpp")
  if(NOT STRINGKERNEL_ENABLE_SIMD)
    return()
  endif()
  string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" cpu_arch)
  if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    # A single-architecture cross-build must follow its target, not the host.
    set(cpu_arch "${CMAKE_OSX_ARCHITECTURES}")
  endif()
  if(cpu_arch MATCHES "^(x86_64|amd64)$")
    if(MSVC)
      set(cpu_options /arch:AVX2 /fp:strict)
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
      set(cpu_options -mavx2 -mpopcnt)
    else()
      return()
    endif()
    set(cpu_source "${PROJECT_SOURCE_DIR}/src/cpu_kernels_avx2.cpp")
    set_source_files_properties("${cpu_source}" PROPERTIES COMPILE_OPTIONS "${cpu_options}")
    target_sources(${target} PRIVATE "${cpu_source}")
    target_compile_definitions(${target} PRIVATE STRINGKERNEL_HAS_AVX2=1)
  elseif(cpu_arch MATCHES "^(aarch64|arm64)$")
    # NEON integer comparisons are part of the supported ARM64 baseline.
    target_sources(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src/cpu_kernels_neon.cpp")
    target_compile_definitions(${target} PRIVATE STRINGKERNEL_HAS_NEON=1)
  endif()
endfunction()
